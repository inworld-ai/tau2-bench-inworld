# ─────────────────────────────────────────────────────────────────────────
#  tau2-bench-inworld — only INWORLD_API_KEY is required
# ─────────────────────────────────────────────────────────────────────────
# Issue a key at https://platform.inworld.ai/ (Profile → API keys).
# Inworld API keys are already base64-encoded — paste them verbatim.
INWORLD_API_KEY=<your_inworld_api_key>


# ── Optional / legacy ─────────────────────────────────────────────────────
# Only needed if you swap a default Inworld-routed component back to its
# original provider. Default config uses Inworld for LLM (text + judge),
# TTS, STT, and full-duplex audio.
# ANTHROPIC_API_KEY=<your_key_here>
# OPENAI_API_KEY=<your_key_here>
# ELEVENLABS_API_KEY=<your_key_here>     # ElevenLabs TTS (legacy fork backend)
# DEEPGRAM_API_KEY=<your_key_here>       # Deepgram STT (legacy fork backend)
# GEMINI_API_KEY=<your_key_here>         # Gemini Live (or GOOGLE_API_KEY / GOOGLE_SERVICE_ACCOUNT_KEY)
# XAI_API_KEY=<your_key_here>            # xAI Grok Voice Agent
# OPENROUTER_API_KEY=<your_key_here>     # banking_knowledge qwen_embeddings retrieval


# ── Voice Persona Overrides ───────────────────────────────────────────────
# Each tau2 persona ships with an Inworld voice picked to match its accent
# (see docs/voice-personas.md). Uncomment any of the following to swap a
# persona's default voice without editing source.
#
# Control personas (American accents, used in "control" complexity):
# TAU2_VOICE_ID_MATT_DELANEY=<inworld_voice_id>
# TAU2_VOICE_ID_LISA_BRENNER=<inworld_voice_id>
#
# Regular personas (diverse accents, used in "regular" complexity):
# TAU2_VOICE_ID_MILDRED_KAPLAN=<inworld_voice_id>
# TAU2_VOICE_ID_ARJUN_ROY=<inworld_voice_id>
# TAU2_VOICE_ID_WEI_LIN=<inworld_voice_id>
# TAU2_VOICE_ID_MAMADOU_DIALLO=<inworld_voice_id>
# TAU2_VOICE_ID_PRIYA_PATIL=<inworld_voice_id>
